# Entorno de ejecución de Node.js
NODE_ENV=production

# Puerto interno del servidor Express (dentro del contenedor)
PORT=3000

# Puerto expuesto en el HOST para la API (docker-compose)
SERVER_PORT=3000

# Puerto expuesto en el HOST para el cliente React (docker-compose)
CLIENT_PORT=3001

# URL pública del backend Express, tal como la ve el navegador del usuario.
# Local:      http://localhost:3000
# Producción: https://api.tudominio.com
REACT_APP_API_URL=http://localhost:3000
